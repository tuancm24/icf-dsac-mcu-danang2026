<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.6.6 Chrome/144.0.7559.236 Electron/40.8.4 Safari/537.36" version="29.6.6">
  <diagram name="Timer-Architecture" id="0">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Hardware Layer -->
        <mxCell id="hw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" value="SONiX SN8F5708 Hardware Timer 0&#xa;(16 MHz / 12 -> 1.000 ms periodic interrupt)" vertex="1">
          <mxGeometry height="60" width="380" x="390" y="40" as="geometry" />
        </mxCell>
        
        <!-- Platform Timer Module -->
        <mxCell id="timer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;align=left;spacingLeft=15;" value="Platform Timer &amp; System Tick Layer&#xa;&#xa;* s_system_tick_ms (1ms Global Accumulator)&#xa;* Timer_Init()&#xa;* Timer_ISR_Handler()&#xa;* Timer_GetTickMs()&#xa;* Timer_HasElapsed(start, duration)&#xa;* Timer_DelayUs(us)" vertex="1">
          <mxGeometry height="160" width="380" x="390" y="160" as="geometry" />
        </mxCell>
        
        <!-- Consumers: Drivers Layer -->
        <mxCell id="disp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" value="Display Driver&#xa;(2ms Multiplexing &amp;&#xa;500ms Blink Phase)" vertex="1">
          <mxGeometry height="70" width="180" x="40" y="380" as="geometry" />
        </mxCell>
        
        <mxCell id="btn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" value="Button Driver&#xa;(10ms Debounce Sampling &amp;&#xa;30ms Filter Window)" vertex="1">
          <mxGeometry height="70" width="190" x="250" y="380" as="geometry" />
        </mxCell>
        
        <mxCell id="buzz" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" value="Buzzer &amp; LED Driver&#xa;(300ms Beep, 5s Alarm,&#xa;500ms D4 Blink)" vertex="1">
          <mxGeometry height="70" width="190" x="470" y="380" as="geometry" />
        </mxCell>
        
        <mxCell id="i2c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" value="I2C EEPROM Driver&#xa;(Timer_DelayUs&#xa;Bit-Banging Timing)" vertex="1">
          <mxGeometry height="70" width="180" x="690" y="380" as="geometry" />
        </mxCell>
        
        <mxCell id="app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" value="Application Layer&#xa;(Clock 1-Sec Tick &amp;&#xa;30-Second Inactivity Timeout)" vertex="1">
          <mxGeometry height="70" width="220" x="900" y="380" as="geometry" />
        </mxCell>
        
        <!-- Connections -->
        <mxCell id="e1" edge="1" parent="1" source="hw" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" target="timer" value="1ms Hardware Interrupt (Vector 1)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e2" edge="1" parent="1" source="timer" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" target="disp" value="Tick / 2ms ISR">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e3" edge="1" parent="1" source="timer" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" target="btn" value="10ms Scan Interval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e4" edge="1" parent="1" source="timer" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" target="buzz" value="Non-blocking Ticks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e5" edge="1" parent="1" source="timer" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" target="i2c" value="DelayUs()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e6" edge="1" parent="1" source="timer" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" target="app" value="1s &amp; 30s Timeout">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
